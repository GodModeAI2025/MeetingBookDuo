    "Off by default. Enabling copies up to 120 characters from each linked page to system widget surfaces. Only saved text is copied; images and handwriting are not shared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Beim Aktivieren werden bis zu 120 Zeichen jeder verknüpften Seite in System-Widgets kopiert. Nur gespeicherter Text wird kopiert; Bilder und Handschrift werden nicht geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Enabling copies up to 120 characters from each linked page to system widget surfaces. Only saved text is copied; images and handwriting are not shared."
          }
        }
      }
    },
    "Offline. Changes remain queued.": {
