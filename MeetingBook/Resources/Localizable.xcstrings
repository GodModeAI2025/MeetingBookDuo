        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A place for your thoughts."
          }
        }
      }
    },
    "A remote record is missing. Local data remains available for recovery.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein entfernter Datensatz fehlt. Lokale Daten bleiben zur Wiederherstellung verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A remote record is missing. Local data remains available for recovery."
          }
        }
      }
    },
    "A transfer exceeds the supported size. Local content and package export remain available.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Übertragung überschreitet die unterstützte Größe. Lokale Inhalte und Paketexport bleiben verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer exceeds the supported size. Local content and package export remain available."
          }
        }
      }
    },
    "A verified safety backup is kept before activation. Sync stays off. Merge adds separate copies of the imported notes. Replace opens the imported notebook in place of the current library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Übernahme wird eine geprüfte Sicherheitskopie angelegt. Die Synchronisierung bleibt aus. Zusammenführen fügt eigenständige Kopien der importierten Notizen hinzu. Ersetzen öffnet das importierte Notizbuch anstelle des aktuellen Notizbuchs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A verified safety backup is kept before activation. Sync stays off. Merge adds separate copies of the imported notes. Replace opens the imported notebook in place of the current library."
          }
        }
      }
    },
    "A verified safety backup is kept before activation. Sync stays off. Replace preserves IDs; merge creates new content IDs.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Aktivierung bleibt eine geprüfte Sicherheitssicherung erhalten. Synchronisierung bleibt aus. Ersetzen erhält die IDs; Zusammenführen vergibt neue Inhalts-IDs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A verified safety backup is kept before activation. Sync stays off. Replace preserves IDs; merge creates new content IDs."
          }
        }
      }
    },
