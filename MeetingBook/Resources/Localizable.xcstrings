      "shouldTranslate": false
    },
    "Packages contain private notes and handwriting fonts. Choose a protected destination. Open MeetingBook packages in MeetingBook; ordinary ZIP archives are not supported. Packages are not password-encrypted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakete enthalten private Notizen und persönliche Handschriften. Wählen Sie einen geschützten Speicherort. Öffnen Sie MeetingBook-Pakete in MeetingBook; gewöhnliche ZIP-Archive werden nicht unterstützt. Pakete sind nicht mit einem Passwort verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages contain private notes and handwriting fonts. Choose a protected destination. Open MeetingBook packages in MeetingBook; ordinary ZIP archives are not supported. Packages are not password-encrypted."
          }
        }
      }
    },
    "Packages contain private notes and handwriting. Choose a protected destination. Packages are standard stored ZIP32 and are not password-encrypted.": {
