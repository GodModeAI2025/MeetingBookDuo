    "Only saved sessions are eligible. Undo and Redo will be cleared explicitly; saved revisions and recovery copies remain available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies gilt nur für gespeicherte Sitzungen. Rückgängig und Wiederholen werden ausdrücklich gelöscht; gespeicherte Versionen und Wiederherstellungskopien bleiben verfügbar."
          }
        },
