          }
        }
      }
    },
    "Optional iCloud transfer requires your consent for the selected account and library, including notes, images and personal handwriting fonts. Local saves continue independently. Keep separate backups of important work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die optionale iCloud-Übertragung benötigt Ihre Zustimmung für das gewählte Konto und Notizbuch, einschließlich Notizen, Bildern und persönlichen Handschriften. Lokales Speichern funktioniert unabhängig davon. Bewahren Sie wichtige Arbeit zusätzlich als Sicherung auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional iCloud transfer requires your consent for the selected account and library, including notes, images and personal handwriting fonts. Local saves continue independently. Keep separate backups of important work."
          }
        }
      }
    },
    "PDF": {
      "comment": "Intentional literal: font specimen, proper name, native language name or file-format abbreviation.",
      "shouldTranslate": false
    },
    "PDF copy and search may differ for emoji, combining marks and fallback scripts. Export TXT for the exact original Unicode text.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Kopieren und Suchen im PDF können Emoji, kombinierende Zeichen und Ersatzschriften abweichen. Exportiere TXT für den exakten ursprünglichen Unicode-Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF copy and search may differ for emoji, combining marks and fallback scripts. Export TXT for the exact original Unicode text."
          }
        }
      }
    },
    "PDF keeps supported text selectable. PNG is flattened at 1440 × 2000 pixels. TXT omits drawings, images and layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF erhält unterstützten Text auswählbar. PNG ist ein flaches Bild mit 1440 × 2000 Pixeln. TXT enthält keine Zeichnungen, Bilder oder Layouts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF keeps supported text selectable. PNG is flattened at 1440 × 2000 pixels. TXT omits drawings, images and layout."
          }
        }
      }
    },
    "PNG": {
