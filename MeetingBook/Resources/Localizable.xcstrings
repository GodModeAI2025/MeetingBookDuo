    "A and B are the preserved source versions shown below. Keeping both also keeps a separate recovery note.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A und B sind die unten gezeigten erhaltenen Quellversionen. Beide behalten erhält zusätzlich eine separate Wiederherstellungsnotiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A and B are the preserved source versions shown below. Keeping both also keeps a separate recovery note."
          }
        }
      }
    },
    "A pending transfer could not be prepared. Retry after local work finishes.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ausstehende Übertragung konnte nicht vorbereitet werden. Versuche es nach Abschluss lokaler Arbeiten erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pending transfer could not be prepared. Retry after local work finishes."
          }
        }
      }
    },
    "A place for your thoughts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Platz für deine Gedanken."
